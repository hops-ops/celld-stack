# code: language=yaml
#
# Compute XR status from observed slices.

{{- $obs := $state.observed }}
{{- $namespaceReady := $obs.namespace.ready | default false }}
{{- $releaseReady := $obs.release.ready | default false }}
{{- $usageReady := true }}
{{- if and $namespaceReady $releaseReady }}
  {{- $usageEntry := get ($.observed.resources | default dict) "usage-celld-namespace" | default dict }}
  {{- $usageStatus := ($usageEntry.resource | default dict).status | default dict }}
  {{- $usageReady = false }}
  {{- range ($usageStatus.conditions | default list) }}
    {{- if and (eq .type "Ready") (eq .status "True") }}
      {{- $usageReady = true }}
    {{- end }}
  {{- end }}
{{- end }}

{{- $awsReady := true }}
{{- if $state.aws.enabled }}
  {{- $awsReady = and $obs.bucket.ready $obs.user.ready $obs.accessKey.ready }}
{{- end }}

{{- $bucketStatus := dict "name" "" "id" "" "ready" false }}
{{- if $state.aws.enabled }}
  {{- $bucketStatus = dict
    "name" $state.aws.bucketName
    "id" ($obs.bucket.id | default "")
    "ready" ($obs.bucket.ready | default false)
  }}
{{- end }}

{{- $state = set $state "status" (dict
  "ready" (and $namespaceReady $releaseReady $usageReady $awsReady)
  "release" (dict
    "name" $state.releaseName
    "namespace" $state.namespace
    "ready" $releaseReady
  )
  "service" (dict
    "name" $state.serviceName
    "namespace" $state.namespace
    "port" 8080
  )
  "bucket" $bucketStatus
) }}
