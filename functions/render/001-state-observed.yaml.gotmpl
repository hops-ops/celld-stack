# code: language=yaml
#
# Observed slices from composed resources.

{{- $observed := $.observed.resources | default dict }}

{{- $readyOf := dict }}
{{- $idOf := dict }}
{{- $arnOf := dict }}
{{- range $key, $entry := $observed }}
  {{- $resource := $entry.resource | default dict }}
  {{- $status := $resource.status | default dict }}
  {{- $atProvider := $status.atProvider | default dict }}
  {{- $ready := false }}
  {{- range ($status.conditions | default list) }}
    {{- if and (eq .type "Ready") (eq .status "True") }}
      {{- $ready = true }}
    {{- end }}
  {{- end }}
  {{- $readyOf = set $readyOf $key $ready }}
  {{- $idOf = set $idOf $key ($atProvider.id | default "") }}
  {{- $arnOf = set $arnOf $key ($atProvider.arn | default "") }}
{{- end }}

{{- $awsCredsEntry := get $observed "aws-creds-secret" | default dict }}
{{- $awsCredsResource := $awsCredsEntry.resource | default dict }}
{{- $awsCredsUid := (($awsCredsResource.metadata | default dict).uid | default "") }}

{{- $podIdentityEntry := get $observed "pod-identity" | default dict }}
{{- $podIdentityResource := $podIdentityEntry.resource | default dict }}
{{- $podIdentityStatus := ($podIdentityResource.status | default dict).podIdentity | default dict }}
{{- $podIdentityRole := $podIdentityStatus.role | default dict }}
{{- $podIdentityAssociation := $podIdentityStatus.association | default dict }}

{{- $state = set $state "observed" (merge $state.observed (dict
  "namespace" (dict "ready" (get $readyOf "namespace" | default false))
  "release" (dict "ready" (get $readyOf "helm-release-celld" | default false))
  "bucket" (dict
    "ready" (get $readyOf "s3-bucket" | default false)
    "id" (get $idOf "s3-bucket" | default "")
  )
  "bucketPab" (dict "ready" (get $readyOf "s3-bucket-pab" | default false))
  "bucketEncryption" (dict "ready" (get $readyOf "s3-bucket-encryption" | default false))
  "podIdentity" (dict
    "ready" (get $readyOf "pod-identity" | default false)
    "roleArn" ($podIdentityAssociation.roleArn | default ($podIdentityRole.arn | default ""))
    "associationId" ($podIdentityAssociation.id | default "")
  )
  "awsCreds" (dict
    "ready" (get $readyOf "aws-creds-secret" | default false)
    "id" $awsCredsUid
  )
)) }}
